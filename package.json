{
  "name": "hacker-news",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "vitest run --config vitest.server.config.mts",
    "test:all": "npm run test:server && ng test --watch=false",
    "test:coverage": "ng test --coverage --watch=false",
    "test:server:coverage": "vitest run --config vitest.server.config.mts --coverage",
    "e2e": "ng build && playwright test",
    "e2e:run": "playwright test",
    "serve:ssr:hacker-news": "node dist/hacker-news/server/server.mjs",
    "start:ssr": "ng build && node dist/hacker-news/server/server.mjs",
    "lint": "ng lint",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.server-test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit"
  },
  "private": true,
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-fastify": "^12.6.3",
    "fastify": "^5.12.8",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
